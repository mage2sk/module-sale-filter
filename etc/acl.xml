<?xml version="1.0"?>
<!--
/**
 * Panth_SaleFilter — ACL.
 *
 * Single branch under Panth_Core::panth_extensions exposes:
 *   - group         : the Sale Filter sidebar node
 *   - index_grid    : admin grid controller access
 *   - index_reindex : refresh-index action
 *   - config        : system.xml section
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Panth_Core::panth_extensions">
                    <resource id="Panth_SaleFilter::group"
                              title="Sale Filter"
                              translate="title"
                              sortOrder="110">
                        <resource id="Panth_SaleFilter::index_grid"
                                  title="Index Grid"
                                  translate="title"
                                  sortOrder="5"/>
                        <resource id="Panth_SaleFilter::index_reindex"
                                  title="Refresh Index"
                                  translate="title"
                                  sortOrder="7"/>
                        <resource id="Panth_SaleFilter::config"
                                  title="Configuration"
                                  translate="title"
                                  sortOrder="10"/>
                        <resource id="Panth_SaleFilter::help"
                                  title="How It Works"
                                  translate="title"
                                  sortOrder="15"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
