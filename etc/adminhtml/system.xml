<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="panth_salefilter" translate="label" type="text"
                 sortOrder="500" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Sale Filter</label>
            <tab>panth</tab>
            <resource>Panth_SaleFilter::config</resource>

            <group id="general" translate="label" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>

                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enables the "On Sale" filter in layered navigation.</comment>
                </field>

                <field id="filter_label" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Filter Title</label>
                    <comment>Header shown above the filter options (e.g. "Sale Status").</comment>
                </field>

                <field id="option_label_on_sale" translate="label comment" type="text" sortOrder="22"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Option Label - On Sale</label>
                    <comment>Label for the option that shows only discounted products (e.g. "On Sale").</comment>
                </field>

                <field id="show_not_on_sale_option" translate="label comment" type="select" sortOrder="24"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show "Not On Sale" Option</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When enabled, the filter lists two options - one for on-sale products and one for regular-price products - so shoppers can toggle between them.</comment>
                </field>

                <field id="option_label_not_on_sale" translate="label comment" type="text" sortOrder="26"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Option Label - Not On Sale</label>
                    <depends>
                        <field id="show_not_on_sale_option">1</field>
                    </depends>
                    <comment>Label for the option that shows only full-price products (e.g. "Regular Price").</comment>
                </field>

                <field id="show_count" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Product Count</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Display the matching product count next to each filter option.</comment>
                </field>

                <field id="include_special_prices" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Special Prices</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Treat products with an active special price as on-sale.</comment>
                </field>

                <field id="include_catalog_rules" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Catalog Rules</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Treat products discounted by a catalog price rule as on-sale.</comment>
                </field>

                <field id="position" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Filter Position</label>
                    <validate>validate-digits</validate>
                    <comment>Sort position of the filter within layered navigation. Lower values appear first.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
