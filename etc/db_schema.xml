<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <!-- ============================================================ -->
    <!-- panth_salefilter_product_index                                 -->
    <!--                                                                -->
    <!-- Per-scope (product x customer group x website) flat index      -->
    <!-- populated by the sale-filter indexer for fast JOIN lookups.    -->
    <!-- ============================================================ -->
    <table name="panth_salefilter_product_index" resource="default" engine="innodb" comment="Panth Sale Filter Product Index">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" comment="Product entity_id"/>
        <column xsi:type="smallint" name="customer_group_id" unsigned="true" nullable="false" comment="Customer group ID (0 = NOT LOGGED IN)"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" comment="Website ID"/>
        <column xsi:type="smallint" name="is_on_sale" unsigned="true" nullable="false" default="0" comment="1 if on sale for this scope, 0 otherwise"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Last reindex timestamp"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
            <column name="customer_group_id"/>
            <column name="website_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PANTH_SALEFILTER_PRODUCT_INDEX_ENTITY_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID"
                    table="panth_salefilter_product_index" column="entity_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="PANTH_SALEFILTER_PRODUCT_INDEX_WEBSITE_ID_STORE_WEBSITE_WEBSITE_ID"
                    table="panth_salefilter_product_index" column="website_id"
                    referenceTable="store_website" referenceColumn="website_id" onDelete="CASCADE"/>
        <index referenceId="PANTH_SALEFILTER_PRODUCT_INDEX_WEBSITE_ID_CUSTOMER_GROUP_ID_IS_ON_SALE" indexType="btree">
            <column name="website_id"/>
            <column name="customer_group_id"/>
            <column name="is_on_sale"/>
        </index>
    </table>

</schema>
